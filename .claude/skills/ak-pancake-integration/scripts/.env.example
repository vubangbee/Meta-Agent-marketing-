# Pancake public API credentials — confirmed working 2026-08-14
# Endpoint: https://pages.fm/api/public_api/v2/pages/{page_id}/conversations
# Auth: per-PAGE "Public API access token" from Pancake page settings — NOT the account
# login session token (that one returns "Invalid access_token", error_code 102).
#
# Add one numbered pair per Facebook Page you manage in Pancake:
PANCAKE_PAGE_ID_1=your_first_page_id
page_access_token_1=your_first_page_public_api_token

PANCAKE_PAGE_ID_2=your_second_page_id
page_access_token_2=your_second_page_public_api_token

# ...continue PANCAKE_PAGE_ID_3 / page_access_token_3, etc. as needed

# Pancake INTERNAL dashboard API session token (JWT) — a SEPARATE auth surface from the
# public API above. Endpoint base: https://pancake.vn/api/v1/... (vs pages.fm/api/public_api/v2
# for everything else in this file). Used for undocumented dashboard actions such as
# toggle_move_to_spam: /pages/{page_id}/customers/{page_customer_id}/toggle_move_to_spam
# (page_customer_id = customers[].id / page_customer.id in a conversation object — NOT
# the c_id, and NOT the top-level customer_id field; see references/api-reference.md).
#
# This is an ACCOUNT LOGIN SESSION token, not a stable API key: it is tied to one Pancake
# user login and carries its own JWT `exp` claim, so it WILL expire (observed ~3-month
# validity). To capture a fresh one: open the Pancake dashboard in a browser, DevTools >
# Network, trigger any /api/v1/ action, copy the `access_token` query param from that
# request's URL.
PANCAKE_INTERNAL_SESSION_TOKEN=your_dashboard_session_jwt

# Conversion funnel stages for `funnel-report` — ordered N=1 (top of funnel) to N=last
# (bottom/converted). TAGS is comma-separated — each entry is either an exact tag label
# (case-sensitive) or one of 3 special reserved keywords:
#   ALL         - matches every conversation unconditionally (typical for stage 1: raw total)
#   HAS_PHONE   - matches conversations with a captured phone number (has_phone field)
#   HAS_AD_ID   - matches conversations with at least one Meta ad_id attributed
# Counting is ADDITIVE per criterion (confirmed 2026-08-14) — a conversation matching 2
# criteria in the same stage (e.g. has tag X AND has_phone) adds 2 to that stage's count,
# not deduplicated to 1. Design each stage's TAGS list with that in mind.
# Example (replace with your own tag names from Pancake):
# FUNNEL_STAGE_1_NAME=Tong tin nhan moi
# FUNNEL_STAGE_1_TAGS=ALL
# FUNNEL_STAGE_2_NAME=Tin nhan chat luong
# FUNNEL_STAGE_2_TAGS=QM
# FUNNEL_STAGE_3_NAME=So dien thoai
# FUNNEL_STAGE_3_TAGS=LLK,HAS_PHONE
# FUNNEL_STAGE_4_NAME=Hen lich
# FUNNEL_STAGE_4_TAGS=Hen lich
# FUNNEL_STAGE_5_NAME=Da len tu van
# FUNNEL_STAGE_5_TAGS=Da len tv
# FUNNEL_STAGE_6_NAME=Da phau thuat
# FUNNEL_STAGE_6_TAGS=Da pt
